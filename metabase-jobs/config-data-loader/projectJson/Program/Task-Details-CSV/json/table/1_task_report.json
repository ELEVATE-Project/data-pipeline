        "query": "SELECT \n    p.created_by AS \"UUID\",\n    p.user_roles AS \"User Type\",\n    p.state_name AS \"Declared State\",\n    p.district_name AS \"District\",\n    p.block_name AS \"Block\",\n    p.school_name AS \"School\",\n    p.school_id AS \"School ID\",\n    p.org_name AS \"Org\",\n    s.program_name AS \"Program\",\n    s.program_id AS \"Program ID\",\n    p.project_id AS \"Project ID\",\n    s.name AS \"Project Title\",\n    s.description AS \"Project Objective\",\n    s.categories AS \"Category\",\n    p.created_date AS \"Project Start date of the user\",\n    p.completed_date AS \"Project completion date of the user\",\n    s.duration AS \"Project Duration\",\n    p.status AS \"Project Status\",\n    t.name AS \"Tasks\",\n\n    -- TASK EVIDENCE\n    CASE \n        WHEN t.evidence IS NOT NULL AND t.evidence <> '' THEN \n            STRING_AGG(\n                DISTINCT ('${base_url}'\n                          || trim(task_ev)),\n                ' , '\n            )\n        ELSE NULL\n    END AS \"Task Evidence\",\n\n    t.remarks AS \"Task Remarks\",\n\n    -- PROJECT EVIDENCE\n    CASE\n        WHEN t.name = (\n            SELECT MIN(t2.name)\n            FROM ${config.tasks} t2\n            WHERE t2.project_id = p.project_id\n        )\n        AND p.evidence IS NOT NULL AND p.evidence <> '' THEN \n            STRING_AGG(\n                DISTINCT ('${base_url}' \n                          || trim(project_ev)),\n                ' , '\n            )\n        ELSE NULL\n    END AS \"Project Evidence\",\n\n    p.remarks AS \"Project Remarks\"\n\nFROM ${config.projects} p\nFULL OUTER JOIN ${config.solutions} s ON p.solution_id = s.solution_id\nFULL OUTER JOIN ${config.tasks} t ON p.project_id = t.project_id\n\nLEFT JOIN LATERAL unnest(string_to_array(t.evidence, ',')) AS task_evidence(task_ev) ON TRUE\nLEFT JOIN LATERAL unnest(string_to_array(p.evidence, ',')) AS project_evidence(project_ev) ON TRUE\n\nWHERE p.program_id = '${program_id}'\n  AND p.solution_id = '${solution_id}'\n\nGROUP BY \n    p.created_by, p.user_roles, p.state_name, p.district_name, \n    p.block_name, p.school_name, p.school_id, p.org_name, \n    s.program_name, s.program_id, p.project_id, s.name, \n    s.description, s.categories, p.created_date, \n    p.completed_date, s.duration, p.status, \n    t.name, t.remarks, p.evidence, p.remarks, t.evidence, t.name;"
      }
    },
